+}
+extern "C" {
+#include <lua\lua.h>
+#include <lua\lualib.h>
+#include <lua\lauxlib.h>
+}
+
+//
+// apollo-c test hook (0002-lem-lua-test-interface): Lua methods as Saturn's
+// (saturn.cpp Lua_InitInstance): get/set_panelswitch, get_agcerasable,
+// get_agcchannel on the LEM's vessel interface. Test instrumentation only.
+//
+
+int LEM::clbkGeneric(int msgid, int prm, void *context)
+{
+	if (msgid == VMSG_LUAINSTANCE)
+		return Lua_InitInstance(context);
+	return 0;
+}
+
+int LEM::Lua_GetPanelSwitch(const char *name) {
+	return MainPanel.GetState(name);
+}
+
+void LEM::Lua_SetPanelSwitch(const char *name, int state) {
+	MainPanel.SetState(name, state);
+}
+
+int LEM::Lua_GetAGCErasable(int page, int addr) {
+	return agc.GetErasable(page, addr);
+}
+
+int LEM::Lua_GetAGCChannel(int ch) {
+	return agc.GetOutputChannel(ch);
+}
+
+static int LemLuaCall_GetPanelSwitch(lua_State *L) {
+	VESSEL **pv = (VESSEL**)lua_touserdata(L, 1);
+	LEM *v = (LEM*)*pv;
+	lua_pushnumber(L, v->Lua_GetPanelSwitch(lua_tostring(L, 2)));
+	return 1;
+}
+
+static int LemLuaCall_SetPanelSwitch(lua_State *L) {
+	VESSEL **pv = (VESSEL**)lua_touserdata(L, 1);
+	LEM *v = (LEM*)*pv;
+	v->Lua_SetPanelSwitch(lua_tostring(L, 2), lua_tointeger(L, 3));
+	return 0;
+}
+
+static int LemLuaCall_GetAGCErasable(lua_State *L) {
+	VESSEL **pv = (VESSEL**)lua_touserdata(L, 1);
+	LEM *v = (LEM*)*pv;
+	lua_pushnumber(L, v->Lua_GetAGCErasable(lua_tointeger(L, 2), lua_tointeger(L, 3)));
+	return 1;
+}
+
+static int LemLuaCall_GetAGCChannel(lua_State *L) {
+	VESSEL **pv = (VESSEL**)lua_touserdata(L, 1);
+	LEM *v = (LEM*)*pv;
+	lua_pushnumber(L, v->Lua_GetAGCChannel(lua_tointeger(L, 2)));
+	return 1;
+}
+
+int LEM::Lua_InitInstance(void *context)
+{
+	lua_State *L = (lua_State*)context;
+	luaL_getmetatable(L, "VESSEL.LEM");
+	if (lua_isnil(L, -1)) { // class not yet registered
+		lua_pop(L, 1);
+		static const struct luaL_reg LEMLib[] = {
+			{"get_panelswitch", LemLuaCall_GetPanelSwitch},
+			{"set_panelswitch", LemLuaCall_SetPanelSwitch},
+			{"get_agcerasable", LemLuaCall_GetAGCErasable},
+			{"get_agcchannel", LemLuaCall_GetAGCChannel},
+			{NULL, NULL}
+		};
+		luaL_newmetatable(L, "LEM.vtable");
+		luaL_openlib(L, "LEM.method", LEMLib, 0);
+		luaL_newmetatable(L, "LEM.base");
+		lua_pushstring(L, "__index");
+		luaL_getmetatable(L, "VESSEL.vtable");
+		lua_settable(L, -3);
+		lua_setmetatable(L, -2);
+		lua_pushstring(L, "__index");
+		lua_pushvalue(L, -2);
+		lua_settable(L, -4);
+		lua_pop(L, 1);
+	}
+	lua_setmetatable(L, -2);
+	return 0;
+}
