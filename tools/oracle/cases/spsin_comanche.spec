# SPSIN / SPCOS -- SINGLE_PRECISION_SUBROUTINES.agc (p.1207 Comanche, p.1101 Luminary)
# Input: A = angle scaled at pi (A/2^14 * pi radians).  Output: A = sin, scaled at 1.
# SPSIN ends with "TC Q", so Q is pointed at ENDOFJOB and we stop there.
# TEMK (scratch) also holds the result.  Same code in both ropes; Comanche055 copy of spsin.spec.
rope Comanche055
entry SPSIN
q ENDOFJOB
stop ENDOFJOB
maxcycles 1000
get A
set A=00000
run spsin_00000
set A=00001
run spsin_00001
set A=02000
run spsin_02000
set A=04000
run spsin_04000
set A=10000
run spsin_10000
set A=14000
run spsin_14000
set A=20000
run spsin_20000
set A=24000
run spsin_24000
set A=30000
run spsin_30000
set A=37777
run spsin_37777
set A=40000
run spsin_40000
set A=50000
run spsin_50000
set A=60000
run spsin_60000
set A=74000
run spsin_74000
set A=77776
run spsin_77776
set A=77777
run spsin_77777
entry SPCOS
set A=00000
run spcos_00000
set A=04000
run spcos_04000
set A=10000
run spcos_10000
set A=20000
run spcos_20000
set A=30000
run spcos_30000
set A=37777
run spcos_37777
set A=60000
run spcos_60000
set A=77777
run spcos_77777
